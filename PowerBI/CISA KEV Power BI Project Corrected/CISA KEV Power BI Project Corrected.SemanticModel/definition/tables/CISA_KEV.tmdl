	column 'CVSS Severity Sort' =
			
			SWITCH (
			    UPPER ( 'CISA_KEV'[CVSS Severity] ),
			    "CRITICAL", 1,
			    "HIGH", 2,
			    "MEDIUM", 3,
			    "LOW", 4,
			    "UNAVAILABLE", 5,
			    99
			)
		formatString: 0
		lineageTag: 26cd63fb-5d3d-4307-b545-e9fcf4a68de3
		summarizeBy: sum

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Risk Tier Sort' =
			
			SWITCH (
			    'CISA_KEV'[Suggested Risk Tier],
			    "Emergency", 1,
			    "Urgent", 2,
			    "High", 3,
			    99
			)
		formatString: 0
		lineageTag: 4d608334-b1af-4a0f-bf8d-14d8bf20fec0
		summarizeBy: sum

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'CVSS Bucket' =
			
			DIVIDE (
			    INT ( 'CISA_KEV'[CVSS Base Score] * 2 ),
			    2
			)
		lineageTag: 42a0b708-7fa4-4729-bf0e-e917df5f3d1a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'EPSS Bucket' =
			
			DIVIDE (
			    INT ( 'CISA_KEV'[EPSS Score] * 10 ),
			    10
			)
		lineageTag: 8cc49b97-5b43-4f84-a897-e8a8e8c57d4d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'CVE Matrix Group' =
			
			FORMAT ( 'CISA_KEV'[CVSS Bucket], "0.0" )
			    & " CVSS | "
			    & FORMAT ( 'CISA_KEV'[EPSS Bucket], "0%" )
			    & " EPSS"
		lineageTag: 481c3014-05ef-4386-81d3-bb1cc2d99e38
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Due Date'
		dataType: dateTime
		formatString: Long Date
		lineageTag: d6c9f55e-d984-4907-8167-d36f6c07e2fc
		summarizeBy: none
		sourceColumn: Due Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Deadline Status' =
			
			VAR DueDate = 'CISA_KEV'[CISA Due Date]
			RETURN
			IF(
			    ISBLANK(DueDate),
			    "No Due Date",
			    SWITCH(
			        TRUE(),
			        DueDate < DATE(2026, 8, 12), "Date Passed",
			        DueDate <= DATE(2026, 9, 11), "Due Within 30 Days",
			        "Future"
			    )
			)
		lineageTag: 87e6fe33-4de3-4f93-940d-348df0fdf0c0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Deadline Status Sort' =
			
			SWITCH(
			    'CISA_KEV'[Deadline Status],
			    "Date Passed", 1,
			    "Due Within 30 Days", 2,
			    "Future", 3,
			    "No Due Date", 4,
			    99
			)
		formatString: 0
		lineageTag: d265f9b2-25b6-49d0-a22d-e54d17e5ec69
		summarizeBy: none

		changedProperty = SortByColumn

		annotation SummarizationSetBy = User

	column 'Priority Tier Sort'
		type: calculated
		lineageTag: fbbcf3ec-f366-46b8-9bd2-761c311f982a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

