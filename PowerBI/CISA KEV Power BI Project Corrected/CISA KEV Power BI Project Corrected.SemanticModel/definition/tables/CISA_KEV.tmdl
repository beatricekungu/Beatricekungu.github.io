	column 'Tech Stack Filter' =
			
			VAR VendorName =
			    TRIM(
			        COALESCE(
			            'CISA_KEV'[Vendor Project],
			            "Unknown Vendor"
			        )
			    )
			VAR ProductName =
			    TRIM(
			        COALESCE(
			            'CISA_KEV'[Product],
			            "Unknown Product"
			        )
			    )
			RETURN
			    VendorName & " > " & ProductName
		lineageTag: b54f9531-de44-4c04-90ff-9c659ee6343f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Deadline Filter' =
			
			VAR DueDate = CISA_KEV[CISA Due Date]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(DueDate), BLANK(),
			        DueDate < TODAY(), "OVERDUE",
			        DueDate <= TODAY() + 30, "DUE ≤30D",
			        BLANK()
			    )
		lineageTag: 5f8a67a9-48d3-4423-95da-4b66f6cb98ec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

