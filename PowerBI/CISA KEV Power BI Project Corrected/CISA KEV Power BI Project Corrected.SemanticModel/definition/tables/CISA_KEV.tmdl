table CISA_KEV
	lineageTag: 51c5af74-cfe1-4edf-9c0b-3f0a9dbca9c7

	measure 'Deadline Selected Color' =
			
			VAR Deadline =
			    SELECTEDVALUE ( 'CISA_KEV'[Deadline Filter] )
			RETURN
			    SWITCH (
			        TRUE(),
			        Deadline = "OVERDUE", "#FF2A5F",
			        Deadline = "DUE ≤30D", "#F59E0B",
			        "#080F19"
			    )
		lineageTag: 30c1cc3e-0c35-4c67-96bc-9c1ab68782a5

	measure 'KEV Additions' =
			
			DISTINCTCOUNT ( 'CISA_KEV'[CVE ID] )
		formatString: 0
		lineageTag: 55b88e08-7f00-4e48-847c-a7c23a04d685

	measure 'Critical CVSS KEVs' =
			
			CALCULATE (
			    [Total CVEs],
			    KEEPFILTERS ( 'CISA_KEV'[CVSS Severity] = "CRITICAL" )
			)
		lineageTag: e6852ffa-4b5d-493f-9238-c9b3376be0e9

	measure 'High EPSS KEVs' =
			
			CALCULATE (
			    [Total CVEs],
			    KEEPFILTERS ( 'CISA_KEV'[EPSS Score] >= 0.70 )
			)
		lineageTag: d662c6bd-5f8b-4476-99db-926be4712a20

	measure 'Severity Share %' =
			
			DIVIDE (
			    [Total CVEs],
			    CALCULATE (
			        [Total CVEs],
			        REMOVEFILTERS ( 'CISA_KEV'[CVSS Severity] )
			    ),
			    0
			)
		lineageTag: 52345025-dcb7-49c0-8098-887f1adbee0d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Risk Tier Share %' =
			
			DIVIDE (
			    [Total CVEs],
			    CALCULATE (
			        [Total CVEs],
			        REMOVEFILTERS ( 'CISA_KEV'[Suggested Risk Tier] )
			    ),
			    0
			)
		lineageTag: 0dab4070-c67e-456a-aed3-c30a71d32a0c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tech Stack Bar Color' =
			
			VAR RankPosition =
			    RANKX (
			        ALLSELECTED ( 'CISA_KEV'[Tech Stack Filter] ),
			        [Total CVEs],
			        ,
			        DESC,
			        DENSE
			    )
			RETURN
			    SWITCH (
			        TRUE(),
			        RankPosition = 1, "#00E5FF",
			        RankPosition <= 3, "#38BDF8",
			        "#2563EB"
			    )
		lineageTag: 5e4a6ee6-72e6-4d79-b315-c04620ea945d

	measure 'CVE Bubble Size' = 1
		formatString: 0
		lineageTag: ac8dc7d9-61c1-49ec-aae5-b18b925e3d49

	measure 'Matrix CVSS' =
			
			MAX('CISA_KEV'[CVSS Base Score])
		formatString: 0.0
		lineageTag: d9ecb82e-b322-4afd-98be-88f0e6913cb4

	measure 'Matrix EPSS' =
			
			MAX('CISA_KEV'[EPSS Score])
		formatString: 0.0
		lineageTag: aab4d870-157c-48a4-87d2-0cf80c80470e

	measure 'Matrix Bubble Size' =
			
			1
		formatString: 0
		lineageTag: 6da0cfd4-a1ea-45fc-9842-12f322f62b5c

	measure 'Matrix EPSS Percent' =
			
			MAX('CISA_KEV'[EPSS Score]) * 100
		formatString: 0.00
		lineageTag: 93d7dd53-ce3f-4b9e-a0ec-c154328a011b

	measure 'Total KEVs' =
			
			COALESCE(
			    DISTINCTCOUNT('CISA_KEV'[CVE ID]),
			    0
			)
		formatString: 0
		lineageTag: b20faf83-c523-41f2-a755-4dcb95b84b6c

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Total KEVs Card' =
			
			FORMAT([Total KEVs], "#,##0")
		lineageTag: 5d1e1cf2-3909-4e3a-8f84-0eb2e4d3da48

	measure 'Critical CVSS KEV' =
			
			-- KEVs with a critical CVSS score of 9.0–10.0
			COALESCE(
			    CALCULATE(
			        [Total KEVs],
			        'CISA_KEV'[CVSS Base Score] >= 9
			    ),
			    0
			)
		formatString: 0
		lineageTag: 41423826-eb4c-455b-892e-73ad6d964b2f

	measure Measure
		lineageTag: 9e104cac-1d22-4202-a67d-5e46b979495b

	measure 'Governance Lens Count' =
			
			VAR SelectedStatus =
			    SELECTEDVALUE ( 'CISA_KEV'[Deadline Status] )
			RETURN
			COALESCE (
			    CALCULATE (
			        COUNT ( 'CISA_KEV'[CVE ID] ),
			        'CISA_KEV'[Deadline Status] = SelectedStatus
			    ),
			    0
			)
		formatString: 0
		lineageTag: b0d01a25-40f3-4c84-a889-52a41a2c79b5

