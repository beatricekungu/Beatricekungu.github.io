table 'Triage Segment'
	lineageTag: 1b3fa964-8e28-4f5a-9bb2-e5643103237a

	measure 'Triage Segment KEVs' =
			
			VAR SelectedSegment =
			    SELECTEDVALUE ( 'Triage Segment'[Triage Segment] )
			VAR Result =
			    SWITCH (
			        SelectedSegment,
			
			        "CRITICAL + LIKELY",
			            CALCULATE (
			                [Total CVEs],
			                KEEPFILTERS ( 'CISA_KEV'[CVSS Base Score] >= 9 ),
			                KEEPFILTERS ( 'CISA_KEV'[EPSS Score] >= 0.70 )
			            ),
			
			        "REMOTE ZERO-CLICK",
			            CALCULATE (
			                [Total CVEs],
			                KEEPFILTERS ( 'CISA_KEV'[Attack Vector] = "NETWORK" ),
			                KEEPFILTERS ( 'CISA_KEV'[User Interaction] = "NONE" )
			            ),
			
			        "PRIV-FREE REMOTE",
			            CALCULATE (
			                [Total CVEs],
			                KEEPFILTERS ( 'CISA_KEV'[Attack Vector] = "NETWORK" ),
			                KEEPFILTERS ( 'CISA_KEV'[Privileges Required] = "NONE" )
			            ),
			
			        "CRITICAL RANSOMWARE",
			            CALCULATE (
			                [Total CVEs],
			                KEEPFILTERS ( 'CISA_KEV'[CVSS Base Score] >= 9 ),
			                KEEPFILTERS ( 'CISA_KEV'[Ransomware] = "Known" )
			            )
			    )
			RETURN
			    COALESCE ( Result, 0 )
		formatString: 0
		lineageTag: baaf9ba3-115b-42c8-a99e-4ab841b844c7

	measure 'Technology KEVs' =
			
			[Total CVEs]
		formatString: 0
		lineageTag: 527f532c-6c7f-4aa2-b0ab-3eadba0f0e80

	measure 'Technology Rank' =
			
			VAR CurrentTechnologyKEVs =
			    [Technology KEVs]
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentTechnologyKEVs ),
			        RANKX (
			            ALLSELECTED ( 'CISA_KEV'[Tech Stack Filter] ),
			            CALCULATE ( [Technology KEVs] ),
			            CurrentTechnologyKEVs,
			            DESC,
			            DENSE
			        )
			    )
		formatString: 0
		lineageTag: d86e311b-d5f8-4ce9-8e3a-7852c0330db8

	column 'Triage Segment'
		lineageTag: 091b6951-1279-45b0-aaac-7e3a1d658b74
		summarizeBy: none
		isNameInferred
		sourceColumn: [Triage Segment]

