		annotation SummarizationSetBy = Automatic

	partition 'Triage Segment' = calculated
		mode: import
		source =
				
				DATATABLE (
				    "Triage Segment", STRING,
				    "Sort Order", INTEGER,
				    "Color", STRING,
				    "Definition", STRING,
				    {
				        {
				            "CRITICAL + LIKELY",
				            1,
				            "#FF2A5F",
				            "CVSS 9.0–10.0 and EPSS ≥ 70%"
				        },
				        {
				            "REMOTE ZERO-CLICK",
				            2,
				            "#F59E0B",
				            "Network attack vector with no user interaction"
				        },
				        {
				            "PRIV-FREE REMOTE",
				            3,
				            "#00E5FF",
				            "Network attack vector with no privileges required"
				        },
				        {
